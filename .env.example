# Database (use "postgres" for Docker, "localhost" for local dev outside Docker)
DATABASE_URL=postgresql+asyncpg://datahandler:datahandler_dev@postgres:5432/datahandler

# MinIO / S3-compatible object storage (use "minio" for Docker, "localhost" for local dev)
MINIO_ENDPOINT=minio:9000
# Browser-reachable MinIO address for presigned download URLs.
MINIO_PUBLIC_ENDPOINT=localhost:9000
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=datahandler
MINIO_USE_SSL=false

# Redis
# Redis (use "redis" for Docker, "localhost" for local dev)
REDIS_URL=redis://redis:6379/0

# Qdrant (Vector DB — use "qdrant" for Docker, "localhost" for local dev)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=datahandler_embeddings

# Celery (uses Redis DB 1 & 2, separate from app cache on DB 0)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Embedding Model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Runtime
ENVIRONMENT=development

# LLM Providers
# Default: reach Ollama running on the host machine from inside the API
# container. If you're running the API directly (no Docker), change to
# http://localhost:11434. If you're using the docker-compose ollama
# service, change to http://ollama:11434 and start with the 'llm' profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3

# Image Pipeline
IMAGE_THUMBNAIL_SIZE=256
IMAGE_MAX_UPLOAD_MB=50
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
QDRANT_IMAGE_COLLECTION=datahandler_image_embeddings

# ── Image embedding performance (CPU-friendly defaults) ──────────────────
# int8-quantize CLIP on CPU: 2-4x faster, ~half the RAM. Set false for
# bit-identical embeddings (slower).
CLIP_QUANTIZE=true
# torch CPU threads (0 = auto = all cores).
CLIP_NUM_THREADS=0
# Images per inference batch.
CLIP_BATCH_SIZE=32
# Parallel MinIO downloads per batch.
CLIP_DOWNLOAD_CONCURRENCY=8
# Warm the CLIP model when the Celery worker boots (off = lazy on first task).
CLIP_PRELOAD=false
