# Database (use "postgres" for Docker, "localhost" for local dev outside Docker)
DATABASE_URL=postgresql+asyncpg://datahandler:datahandler_dev@postgres:5432/datahandler

# MinIO / S3-compatible object storage (use "minio" for Docker, "localhost" for local dev)
# ── Object storage (S3) ──────────────────────────────────────────────────
# The stack now runs SeaweedFS, not MinIO — minio/minio stopped being publicly
# pullable in Sept 2026. The variables keep their MINIO_ prefix because the app
# reads them by those names and the client library is called `minio`; they mean
# "S3 endpoint", not "MinIO specifically".
#
# 8333 is SeaweedFS's S3 port (MinIO used 9000).
MINIO_ENDPOINT=seaweedfs:8333
# Browser-reachable MinIO address for presigned download URLs.
# Browser-reachable address. Must be the HOST's address, not the container's:
# presigned URLs are handed to the browser, which cannot resolve `seaweedfs`.
MINIO_PUBLIC_ENDPOINT=localhost:8333
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET_NAME=datahandler
MINIO_USE_SSL=false

# Redis
# Redis (use "redis" for Docker, "localhost" for local dev)
REDIS_URL=redis://redis:6379/0

# Qdrant (Vector DB — use "qdrant" for Docker, "localhost" for local dev)
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_COLLECTION=datahandler_embeddings

# Celery (uses Redis DB 1 & 2, separate from app cache on DB 0)
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Embedding Model (sentence-transformers model name)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# Runtime
ENVIRONMENT=development

# LLM Providers
# Default: reach Ollama running on the host machine from inside the API
# container. If you're running the API directly (no Docker), change to
# http://localhost:11434. If you're using the docker-compose ollama
# service, change to http://ollama:11434 and start with the 'llm' profile.
OLLAMA_BASE_URL=http://host.docker.internal:11434
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
DEFAULT_LLM_PROVIDER=ollama
DEFAULT_LLM_MODEL=llama3

# Image Pipeline
IMAGE_THUMBNAIL_SIZE=256
IMAGE_MAX_UPLOAD_MB=50
CLIP_MODEL_NAME=openai/clip-vit-base-patch32
QDRANT_IMAGE_COLLECTION=datahandler_image_embeddings

# ── Image embedding performance (CPU-friendly defaults) ──────────────────
# int8-quantize CLIP on CPU: 2-4x faster, ~half the RAM. Set false for
# bit-identical embeddings (slower).
CLIP_QUANTIZE=true
# torch CPU threads (0 = auto = all cores).
CLIP_NUM_THREADS=0
# Images per inference batch.
CLIP_BATCH_SIZE=32
# Parallel MinIO downloads per batch.
CLIP_DOWNLOAD_CONCURRENCY=8
# Warm the CLIP model when the Celery worker boots (off = lazy on first task).
CLIP_PRELOAD=false

# ── Third-party container images ─────────────────────────────────────────
# NOT ours: pulled from public registries whose owners can withdraw a tag at
# any time. That is exactly what happened to minio/minio — it went private on
# Docker Hub AND quay.io, breaking every clean install while cached machines
# carried on working.
#
# Override any of these to a tag, a digest, or a mirror you control, without
# editing compose or rebuilding:
#
#   S3_IMAGE=chrislusf/seaweedfs:3.68
#   S3_IMAGE=ghcr.io/<you>/seaweedfs:pinned
#
# Pinning by digest is strongest — the bytes cannot change under you.
S3_IMAGE=chrislusf/seaweedfs:latest
QDRANT_IMAGE=qdrant/qdrant:latest
OLLAMA_IMAGE=ollama/ollama:latest

# Only used with `--profile minio` (the legacy object store). Left here for
# anyone with a cached or mirrored copy. A digest that was valid before the
# repository went private:
#   MINIO_IMAGE=minio/minio@sha256:14cea493d9a34af32f524e538b8346cf79f3321eff8e708c1e2960462bd8936e
MINIO_IMAGE=minio/minio:latest

# ── Upgrading an existing install ────────────────────────────────────────
# SeaweedFS and MinIO store bytes differently, so images uploaded under MinIO
# are NOT readable by SeaweedFS even though both use the same volume. On an
# existing install either re-upload your datasets, or keep using MinIO with
# `--profile minio` and MINIO_ENDPOINT=minio:9000.
